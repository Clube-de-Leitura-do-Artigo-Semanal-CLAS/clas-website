# Copia este ficheiro para .env e preenche com os teus dados locais.
# Nunca commites o .env real — ele já está no .gitignore.

APP_ENV=local
APP_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clas_website
DB_USERNAME=root
DB_PASSWORD=

# Chave secreta para sessões/tokens. Gera uma nova para cada ambiente.
APP_SECRET=

# Token que o KwiZ usa para autenticar quando envia relatórios de turma
# (ver app/Services/KwizIntegrationService.php e routes/api.php)
KWIZ_API_TOKEN=
