# Copia este ficheiro para .env e preenche com os teus dados locais.
# NUNCA metas o .env real no git — já está no .gitignore por segurança.

DB_HOST=127.0.0.1
DB_NAME=clas_website
DB_USER=root
DB_PASS=

# Chave usada para assinar sessões/tokens de autenticação de membros
APP_SECRET=muda-isto-para-uma-string-aleatoria

# URL base do site (sem barra final)
APP_URL=http://localhost:8000

# Ambiente: local | staging | production
APP_ENV=local
