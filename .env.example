# Copia este ficheiro para .env e preenche com os teus dados.
# NUNCA metas o .env real no git — já está protegido pelo .gitignore.

# --- Base de dados (Supabase / PostgreSQL) ---
DB_HOST=
DB_PORT=
DB_NAME=postgres
DB_USER=postgres
DB_PASS=
DB_SCHEMA=public

# --- Supabase (autenticação) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Ambiente: local | staging | production ---
APP_ENV=

# --- SMS (ativação de conta por OTP) ---
TELCO_SMS_API_KEY=
