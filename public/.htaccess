# Redireciona todos os pedidos para index.php, exceto ficheiros que existem
# de facto (css, js, imagens) — assim conseguimos ter URLs limpos tipo
# /membros/perfil em vez de /membros/perfil.php

RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
