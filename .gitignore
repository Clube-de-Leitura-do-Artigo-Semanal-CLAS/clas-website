# Ambiente local — nunca sobe credenciais para o repositório
.env

# Dependências, se vierem a ser usadas
/vendor/

# Uploads dos membros (fotos de resenhas, etc.) — não versionar conteúdo gerado por utilizadores
/public/uploads/*
!/public/uploads/.gitkeep

# Ficheiros de sistema
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Dados pessoais dos membros — NUNCA versionar.
# O CLASID.xlsx e o membros.json têm nomes reais de 490 pessoas.
